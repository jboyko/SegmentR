# Comparing Geodesic vs. Euclidean Distances for a Particle Moving at Constant Rate
# Set random seed for reproducibility
set.seed(42)
# Function to convert latitude/longitude to 3D Cartesian coordinates
# Assumes sphere of radius 1
latlon_to_cartesian <- function(lat, lon) {
lat_rad <- lat * pi/180
lon_rad <- lon * pi/180
x <- cos(lat_rad) * cos(lon_rad)
y <- cos(lat_rad) * sin(lon_rad)
z <- sin(lat_rad)
return(c(x, y, z))
}
# Function to calculate the geodesic distance between two points on a sphere
# Returns distance in the same units as the radius (which is 1 here)
geodesic_distance <- function(lat1, lon1, lat2, lon2) {
# Convert to radians
lat1_rad <- lat1 * pi/180
lon1_rad <- lon1 * pi/180
lat2_rad <- lat2 * pi/180
lon2_rad <- lon2 * pi/180
# Haversine formula
dlat <- lat2_rad - lat1_rad
dlon <- lon2_rad - lon1_rad
a <- sin(dlat/2)^2 + cos(lat1_rad) * cos(lat2_rad) * sin(dlon/2)^2
c <- 2 * atan2(sqrt(a), sqrt(1-a))
# Distance (on unit sphere, radius = 1)
return(c)
}
# Function to calculate Euclidean distance between two points
euclidean_distance <- function(p1, p2) {
return(sqrt(sum((p1 - p2)^2)))
}
# Function to interpolate points along a great circle (geodesic)
# t ranges from 0 to 1
interpolate_great_circle <- function(lat1, lon1, lat2, lon2, t) {
# Convert to radians
lat1_rad <- lat1 * pi/180
lon1_rad <- lon1 * pi/180
lat2_rad <- lat2 * pi/180
lon2_rad <- lon2 * pi/180
# Convert to Cartesian
p1 <- c(cos(lat1_rad) * cos(lon1_rad),
cos(lat1_rad) * sin(lon1_rad),
sin(lat1_rad))
p2 <- c(cos(lat2_rad) * cos(lon2_rad),
cos(lat2_rad) * sin(lon2_rad),
sin(lat2_rad))
# Calculate the angle between the points
omega <- acos(sum(p1 * p2))
# If points are very close or antipodal, handle specially
if (abs(omega) < 1e-10) {
return(c(lat1, lon1))
}
if (abs(omega - pi) < 1e-10) {
# Antipodal points - arbitrary path
return(c(0, lon1 + 180 * t))
}
# Calculate the interpolated point in Cartesian coordinates
sin_omega <- sin(omega)
p <- (sin((1-t)*omega) / sin_omega) * p1 + (sin(t*omega) / sin_omega) * p2
# Convert back to lat/lon
lat_out <- asin(p[3]) * 180/pi
lon_out <- atan2(p[2], p[1]) * 180/pi
return(c(lat_out, lon_out))
}
# Define the starting point - North Pole
start_lat <- 90
start_lon <- 0  # Longitude doesn't matter at poles
# Define the ending point - South Pole
end_lat <- -90
end_lon <- 0  # Longitude doesn't matter at poles
# Define constant angular rate of movement (in degrees per time unit)
# This will determine how far the particle moves along the great circle
angular_rate <- 1  # degree per time unit - slow movement to get more data points
# The movement follows the meridian from North to South pole
# No need for initial bearing as we're moving directly south along a meridian
initial_bearing <- 180  # Due South
# Function to calculate destination point given start, bearing, and distance
destination_point <- function(lat1, lon1, bearing, distance) {
# Convert to radians
lat1_rad <- lat1 * pi/180
lon1_rad <- lon1 * pi/180
bearing_rad <- bearing * pi/180
# Angular distance in radians
angular_distance <- distance
# Calculate destination
sin_lat2 <- sin(lat1_rad) * cos(angular_distance) + cos(lat1_rad) * sin(angular_distance) * cos(bearing_rad)
lat2_rad <- asin(sin_lat2)
lon2_rad <- lon1_rad + atan2(sin(bearing_rad) * sin(angular_distance) * cos(lat1_rad),
cos(angular_distance) - sin(lat1_rad) * sin(lat2_rad))
# Convert back to degrees
lat2 <- lat2_rad * 180/pi
lon2 <- lon2_rad * 180/pi
# Normalize longitude to -180 to 180
lon2 <- ((lon2 + 180) %% 360) - 180
return(c(lat2, lon2))
}
# Define the time values to analyze (how long the particle travels)
# Since we're moving at 1 degree per time unit, time = angular distance in degrees
# For pole-to-pole movement, we need to cover 180 degrees
# Create a more densely sampled sequence of time values
time_values <- c(
# Very small values for near-zero behavior
seq(0.1, 1, by=0.1),
# More detail for the first part of the journey
seq(2, 10, by=1),
# Medium range with slightly wider spacing
seq(15, 45, by=5),
# Approaching the equator (closer to 90°)
seq(50, 85, by=5),
# Very close to the equator
seq(86, 94, by=1),
# Moving away from the equator toward South pole
seq(95, 130, by=5),
# Final approach to South pole
seq(135, 180, by=5)
)
# Create a data frame to store the results
results <- data.frame(
time = numeric(),
geodesic_distance = numeric(),
euclidean_distance = numeric(),
geodesic_rate = numeric(),
euclidean_rate = numeric(),
ratio = numeric()
)
# Calculate the maximum time based on the sphere's circumference
# (to avoid wrapping around the sphere multiple times)
max_time <- 360 / angular_rate
if (max(time_values) > max_time) {
warning(paste("Some time values exceed the time needed for a full circumnavigation (", max_time, " time units)"))
}
# Calculate the distances and rates for each time value
for (t in time_values) {
# Calculate the angular distance covered in time t
angular_distance <- angular_rate * t * pi/180  # convert to radians
# Find the endpoint after traveling for time t
endpoint <- destination_point(start_lat, start_lon, initial_bearing, angular_distance)
end_lat <- endpoint[1]
end_lon <- endpoint[2]
# Calculate the geodesic distance (should equal angular_distance in radians)
geo_dist <- geodesic_distance(start_lat, start_lon, end_lat, end_lon)
# Calculate the Euclidean distance
start_cart <- latlon_to_cartesian(start_lat, start_lon)
end_cart <- latlon_to_cartesian(end_lat, end_lon)
euc_dist <- euclidean_distance(start_cart, end_cart)
# Calculate rates (distance per unit time)
geo_rate <- geo_dist / t
euc_rate <- euc_dist / t
# Calculate the ratio of Euclidean to geodesic rate
ratio <- euc_rate / geo_rate
# Add the results to the data frame
results <- rbind(results, data.frame(
time = t,
geodesic_distance = geo_dist,
euclidean_distance = euc_dist,
geodesic_rate = geo_rate,
euclidean_rate = euc_rate,
ratio = ratio
))
}
# Calculate percent difference and absolute difference
results$percent_diff <- (results$geodesic_rate - results$euclidean_rate) / results$geodesic_rate * 100
results$abs_diff <- results$geodesic_rate - results$euclidean_rate
# Calculate angle in degrees for reference
results$angle_degrees <- results$geodesic_distance * 180/pi
# Plotting
